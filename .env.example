# Flask Secret Key
SECRET_KEY=your-secret-key-here-change-in-production

# Database URL (PostgreSQL)
# 優先順位: .env → 環境変数 → デフォルト(accounting_dev) → SQLite
DATABASE_URL=postgresql://postgres:n-N31415926!!@localhost:5432/accounting_dev

# Application Settings
APP_NAME=login-system-app
ENV=dev
DEBUG=1
APP_VERSION=0.1.0
TZ=Asia/Tokyo

# ===== 会計ソフト連携（受信資料の自動アップロード） =====
# freee会計（https://developer.freee.co.jp でアプリ登録）
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
# リダイレクトURIは /accounting/callback/freee を指すこと
FREEE_REDIRECT_URI=https://your-domain/accounting/callback/freee

# マネーフォワード クラウド（パートナーAPI申請が必要）
MF_CLIENT_ID=
MF_CLIENT_SECRET=
# リダイレクトURIは /accounting/callback/moneyforward を指すこと
MF_REDIRECT_URI=https://your-domain/accounting/callback/moneyforward
# 以下はMFのプロダクト/契約により異なるため、パートナーAPIドキュメントで確認して上書き
# MF_SCOPE=office:read receipt:write
# MF_AUTH_BASE=https://api.biz.moneyforward.com
# MF_API_BASE=https://api.biz.moneyforward.com
# MF_OFFICE_PATH=/api/v1/offices
# MF_UPLOAD_PATH=/api/v1/receipts
# MF_UPLOAD_FILE_FIELD=file
