#!/usr/bin/env bash
# Heroku Python buildpack はビルド後にこのスクリプトを実行する。
# playwright buildpack は実行時に PLAYWRIGHT_BROWSERS_PATH=0 を強制する
# （＝playwrightパッケージ内 .local-browsers を参照）。
# そのため導入先も 0 に固定し、実行時の参照先と一致させる。
set +e
export PLAYWRIGHT_BROWSERS_PATH=0
echo "-----> post_compile: Playwright Chromium を導入します (PLAYWRIGHT_BROWSERS_PATH=0 / パッケージ内)"
python -m playwright install chromium
echo "-----> post_compile: 導入完了 (exit=$?)"
exit 0
