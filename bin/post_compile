#!/usr/bin/env bash
# Heroku Python buildpack はビルド後にこのスクリプトを実行する。
# 実行時に参照する PLAYWRIGHT_BROWSERS_PATH へ Chromium 本体（headless shell 含む）を
# 確実に導入する。OS依存ライブラリは playwright buildpack 側が用意する。
set +e
echo "-----> post_compile: Playwright Chromium を導入します (PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-default})"
python -m playwright install chromium
echo "-----> post_compile: 導入完了 (exit=$?)"
exit 0
